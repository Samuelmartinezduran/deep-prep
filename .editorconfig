# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Igual que line-length de [tool.ruff] en pyproject.toml.
[*.py]
max_line_length = 130

[*.{js,mjs,css,html,svg,yml,yaml}]
indent_size = 2

# Datos de prueba y maquetas: los escribe json.dump(..., indent=1).
[*.json]
indent_size = 1

# En Markdown, dos espacios al final de una línea son un salto de línea.
[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
